{
  "_doc": "Shared cases for backend/app/transitions.py and frontend/src/timeline/transitions.ts. Source durations: null = photo (unlimited).",
  "cases": [
    {"name": "full transition with spare footage on both sides",
     "a": {"start": 0, "inPoint": 0, "outPoint": 4}, "srcA": 10,
     "b": {"start": 4, "inPoint": 2, "outPoint": 6}, "srcB": 10,
     "duration": 1, "expect": {"status": "ok", "half": 0.5, "freezeA": false, "freezeB": false}},
    {"name": "left clip used to its very end -> freeze its last frame",
     "a": {"start": 0, "inPoint": 6, "outPoint": 10}, "srcA": 10,
     "b": {"start": 4, "inPoint": 2, "outPoint": 6}, "srcB": 10,
     "duration": 1, "expect": {"status": "freeze", "half": 0.5, "freezeA": true, "freezeB": false}},
    {"name": "only 0.2 s spare on the left -> shortened to 0.4 s",
     "a": {"start": 0, "inPoint": 0, "outPoint": 9.8}, "srcA": 10,
     "b": {"start": 9.8, "inPoint": 5, "outPoint": 8}, "srcB": 10,
     "duration": 1, "expect": {"status": "shortened", "half": 0.2, "freezeA": false, "freezeB": false}},
    {"name": "0.04 s spare is under the 0.1 s minimum -> freeze",
     "a": {"start": 0, "inPoint": 0, "outPoint": 4}, "srcA": 10,
     "b": {"start": 4, "inPoint": 0.04, "outPoint": 3}, "srcB": 10,
     "duration": 1, "expect": {"status": "freeze", "half": 0.5, "freezeA": false, "freezeB": true}},
    {"name": "photos have unlimited handles",
     "a": {"start": 0, "inPoint": 0, "outPoint": 3}, "srcA": null,
     "b": {"start": 3, "inPoint": 0, "outPoint": 3}, "srcB": null,
     "duration": 1.5, "expect": {"status": "ok", "half": 0.75, "freezeA": false, "freezeB": false}},
    {"name": "short clip caps the transition at half its length",
     "a": {"start": 0, "inPoint": 0, "outPoint": 0.5}, "srcA": null,
     "b": {"start": 0.5, "inPoint": 0, "outPoint": 3}, "srcB": null,
     "duration": 2, "expect": {"status": "shortened", "half": 0.25, "freezeA": false, "freezeB": false}},
    {"name": "speed 2 halves the spare footage",
     "a": {"start": 0, "inPoint": 0, "outPoint": 9.6, "speed": 2}, "srcA": 10,
     "b": {"start": 4.8, "inPoint": 3, "outPoint": 6}, "srcB": 10,
     "duration": 1, "expect": {"status": "shortened", "half": 0.2, "freezeA": false, "freezeB": false}},
    {"name": "duration clamps to 2 s",
     "a": {"start": 0, "inPoint": 0, "outPoint": 6}, "srcA": null,
     "b": {"start": 6, "inPoint": 0, "outPoint": 6}, "srcB": null,
     "duration": 5, "expect": {"status": "ok", "half": 1.0, "freezeA": false, "freezeB": false}},
    {"name": "clips that do not touch get no transition",
     "a": {"start": 0, "inPoint": 0, "outPoint": 2}, "srcA": null,
     "b": {"start": 2.5, "inPoint": 0, "outPoint": 2}, "srcB": null,
     "duration": 1, "expect": null}
  ]
}
